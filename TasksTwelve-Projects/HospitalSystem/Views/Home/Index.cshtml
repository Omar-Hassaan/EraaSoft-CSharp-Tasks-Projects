@{
    ViewData["Title"] = "Welcome";
}

<div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container position-relative">
        <div class="row min-vh-90 align-items-center justify-content-center text-center">
            <div class="col-lg-8">
                <div class="hero-badge mb-3">
                    <i class="fa-solid fa-shield-heart me-2"></i>Trusted Healthcare
                </div>
                <h1 class="hero-title">Your Health,<br /><em>Our Priority</em></h1>
                <p class="hero-subtitle mt-3 mb-5">
                    Book appointments with our expert doctors quickly and easily.<br />
                    Quality care, available when you need it most.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-hero-primary btn-lg px-5 py-3">
                        <i class="fa-solid fa-calendar-check me-2"></i>Make Appointment
                    </a>
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-hero-outline btn-lg px-5 py-3">
                        <i class="fa-solid fa-list-check me-2"></i>View Appointments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="stats-section py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-user-doctor"></i></div>
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Expert Doctors</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-stethoscope"></i></div>
                    <div class="stat-number">20+</div>
                    <div class="stat-label">Specializations</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
                    <div class="stat-number">24/7</div>
                    <div class="stat-label">Support</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-award"></i></div>
                    <div class="stat-number">15+</div>
                    <div class="stat-label">Years Experience</div>
                </div>
            </div>
        </div>
    </div>
</section>