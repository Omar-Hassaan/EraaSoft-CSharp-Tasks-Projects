@model HospitalSystem.ViewModels.DoctorsFilterVM
@{
    ViewData["Title"] = "Our Doctors";
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title"><i class="fa-solid fa-user-doctor me-3"></i>Our Doctors</h1>
                <p class="page-subtitle">Find the right specialist for you</p>
            </div>
            <div class="col-auto">
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-light">
                    <i class="fa-solid fa-list-check me-2"></i>View Appointments
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <!-- Filter Card -->
    <div class="filter-card mb-4">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        <i class="fa-solid fa-magnifying-glass me-1 text-primary"></i>Search by Name
                    </label>
                    <input type="text" name="searchName" value="@Model.SearchName"
                           class="form-control form-control-custom"
                           placeholder="e.g. Dr. Ahmed..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="fa-solid fa-stethoscope me-1 text-primary"></i>Specialization
                    </label>
                    <select name="searchSpecialization" class="form-select form-control-custom">
                        <option value="">All Specializations</option>
                        @foreach (var spec in Model.Specializations)
                        {
                            <option value="@spec" selected="@(Model.SearchSpecialization == spec)">
                                @spec
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Results Info -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">
            Showing <strong>@Model.Doctors.Count</strong> of <strong>@Model.TotalCount</strong> doctors
            @if (!string.IsNullOrEmpty(Model.SearchName) || !string.IsNullOrEmpty(Model.SearchSpecialization))
            {
                <span class="badge bg-primary ms-2">Filtered</span>
            }
        </p>
    </div>

    <!-- Doctors Grid -->
    @if (!Model.Doctors.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="fa-solid fa-user-doctor fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No doctors found</h4>
            <p class="text-muted">Try adjusting your search filters.</p>
            <a asp-action="Index" class="btn btn-primary-custom mt-2">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var doctor in Model.Doctors)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="doctor-card">
                        <div class="doctor-card-img-wrap">
                            <img src="@doctor.ImageUrl"
                            
                                 alt="@doctor.Name"
                                 class="doctor-card-img"
                                 onerror="this.src='/images/default-doctor.png'" />
                            
                            <div class="doctor-spec-badge">@doctor.Specialization</div>
                        </div>
                        <div class="doctor-card-body">
                            <h5 class="doctor-name">@doctor.Name</h5>
                            <p class="doctor-spec">
                                <i class="fa-solid fa-stethoscope me-1"></i>@doctor.Specialization
                            </p>
                            <div class="doctor-meta">
                                <span><i class="fa-regular fa-clock me-1"></i>Sun – Thu</span>
                                <span><i class="fa-solid fa-calendar me-1"></i>9 AM – 4:30 PM</span>
                            </div>
                            <a asp-controller="Appointments" asp-action="Create"
                                   asp-route-doctorId="@doctor.Id"
                                   class="btn btn-book w-100 mt-3">
                                <i class="fa-solid fa-calendar-plus me-2"></i>Book Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center" aria-label="Doctors pagination">
                <ul class="pagination pagination-custom">
                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-searchName="@Model.SearchName"
                               asp-route-searchSpecialization="@Model.SearchSpecialization">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchName="@Model.SearchName"
                                   asp-route-searchSpecialization="@Model.SearchSpecialization">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-searchName="@Model.SearchName"
                               asp-route-searchSpecialization="@Model.SearchSpecialization">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
