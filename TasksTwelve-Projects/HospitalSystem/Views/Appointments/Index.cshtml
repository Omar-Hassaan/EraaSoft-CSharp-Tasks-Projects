@model IEnumerable<HospitalSystem.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title"><i class="fa-solid fa-list-check me-3"></i>All Appointments</h1>
                <p class="page-subtitle">Overview of all booked appointments</p>
            </div>
            <div class="col-auto">
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-light">
                    <i class="fa-solid fa-plus me-2"></i>New Appointment
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-custom mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="fa-regular fa-calendar-xmark fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No appointments yet</h4>
            <p class="text-muted">Be the first to book an appointment with one of our doctors.</p>
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary-custom mt-2">
                <i class="fa-solid fa-calendar-plus me-2"></i>Book Now
            </a>
        </div>
    }
    else
    {
        <div class="appointments-count mb-3">
            <span class="badge-count">@Model.Count() appointment@(Model.Count() != 1 ? "s" : "")</span>
        </div>

        <div class="table-card">
            <div class="table-responsive">
                <table class="table table-appointments mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th><i class="fa-solid fa-user me-2"></i>Patient</th>
                            <th><i class="fa-solid fa-user-doctor me-2"></i>Doctor</th>
                            <th><i class="fa-solid fa-stethoscope me-2"></i>Specialization</th>
                            <th><i class="fa-regular fa-calendar me-2"></i>Date</th>
                            <th><i class="fa-regular fa-clock me-2"></i>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var appt in Model)
                        {
                            var isPast = appt.AppointmentDate < DateOnly.FromDateTime(DateTime.Today);
                            var isToday = appt.AppointmentDate == DateOnly.FromDateTime(DateTime.Today);
                            <tr class="@(isPast ? "row-past" : "") @(isToday ? "row-today" : "")">
                                <td class="text-muted">@index</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="patient-avatar">
                                            @appt.PatientName[0]
                                        </div>
                                        <strong>@appt.PatientName</strong>
                                    </div>
                                </td>
                                <td>@appt.Doctor?.Name</td>
                                <td>
                                    <span class="spec-badge">@appt.Doctor?.Specialization</span>
                                </td>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@appt.AppointmentTime.ToString("hh:mm tt")</td>
                                <td>
                                    @if (isPast)
                                    {
                                        <span class="status-badge status-completed">Completed</span>
                                    }
                                    else if (isToday)
                                    {
                                        <span class="status-badge status-today">Today</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-upcoming">Upcoming</span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
