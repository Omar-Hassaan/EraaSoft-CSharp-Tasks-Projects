@{ ViewData["Title"] = "Booking Confirmed"; }

<div class="container py-5 text-center">
    <div style="font-size:5rem" class="mb-3">🎉</div>
    <h2 class="fw-black text-white mb-2">Booking Confirmed!</h2>
    <p class="text-muted fs-5 mb-4">Your seats have been reserved. Enjoy the movie!</p>
    @if (TempData["BookingEmail"] != null)
    {
        <p class="text-muted">A confirmation has been sent to <strong class="text-white">@TempData["BookingEmail"]</strong></p>
    }
    <div class="d-flex gap-3 justify-content-center mt-4">
        <a asp-area="Customer" asp-controller="Booking" asp-action="MyBookings"
           asp-route-email="@TempData["BookingEmail"]" class="btn btn-book px-4 py-2">
            <i class="bi bi-ticket-perforated me-2"></i>View My Bookings
        </a>
        <a asp-area="Customer" asp-controller="Movie" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
            Browse More Movies
        </a>
    </div>
</div>
