@model MovieBookingApp.Models.Cinema
@{ ViewData["Title"] = "Edit Cinema"; }
<div class="card" style="max-width:500px;margin:auto">
    <div class="card-header bg-white border-0 pt-4 px-4"><h6 class="fw-bold mb-0">Edit Cinema</h6></div>
    <div class="card-body px-4 pb-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="mb-3"><label asp-for="Name" class="form-label fw-semibold">Cinema Name</label><input asp-for="Name" class="form-control" /></div>
            <div class="mb-3"><label asp-for="Location" class="form-label fw-semibold">Location</label><input asp-for="Location" class="form-control" /></div>
            <div class="mb-3"><label asp-for="ImageUrl" class="form-label fw-semibold">Image URL</label><input asp-for="ImageUrl" class="form-control" /></div>
            <div class="d-flex gap-2"><button type="submit" class="btn btn-warning px-4">Update</button><a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a></div>
        </form>
    </div>
</div>
