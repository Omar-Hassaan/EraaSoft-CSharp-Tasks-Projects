@model MovieBookingApp.Models.Cinema
@{ ViewData["Title"] = "Cinema Details"; }
<div class="card" style="max-width:600px;margin:auto">
    <img src="@(Model.ImageUrl ?? "https://via.placeholder.com/600x200")" class="card-img-top" style="height:200px;object-fit:cover" />
    <div class="card-body p-4">
        <h4 class="fw-bold">@Model.Name</h4>
        <p class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.Location</p>
        <hr /><h6>Movies showing here:</h6>
        <ul class="list-group">@foreach (var m in Model.Movies) { <li class="list-group-item">🎬 @m.Name</li> }</ul>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back</a>
    </div>
</div>
