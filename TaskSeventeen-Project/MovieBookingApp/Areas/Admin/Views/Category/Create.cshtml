@model MovieBookingApp.Models.Category
@{ ViewData["Title"] = "Add Category"; }
<div class="card" style="max-width:400px;margin:auto">
    <div class="card-header bg-white border-0 pt-4 px-4"><h6 class="fw-bold mb-0">Add Category</h6></div>
    <div class="card-body px-4 pb-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                <input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-info text-white px-4">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
