@model IEnumerable<MovieBookingApp.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="card">
    <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-tags me-2 text-info"></i>All Categories</h6>
        <a asp-action="Create" class="btn btn-info btn-sm text-white"><i class="bi bi-plus me-1"></i>Add Category</a>
    </div>
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr class="text-muted small"><th>ID</th><th>Name</th><th>Movies</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-muted">#@c.Id</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td><span class="badge bg-secondary">@c.Movies.Count movies</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info btn-action me-1"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning btn-action me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger btn-action"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
