@model IEnumerable<MovieBookingApp.Models.Booking>
@{ ViewData["Title"] = "All Bookings"; }

<div class="card">
    <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
        <h6 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2 text-primary"></i>All Bookings</h6>
    </div>
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>#</th><th>Customer</th><th>Movie</th><th>Seats</th><th>Total</th><th>Date</th><th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="text-muted">#@b.Id</td>
                        <td>
                            <div class="fw-semibold">@b.CustomerName</div>
                            <div class="text-muted small">@b.CustomerEmail</div>
                            <div class="text-muted small">@b.CustomerPhone</div>
                        </td>
                        <td>@b.Movie?.Name</td>
                        <td>@b.NumberOfSeats</td>
                        <td class="fw-semibold">@b.TotalPrice.ToString("N0") EGP</td>
                        <td class="text-muted small">@b.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @{
                                var cls = b.Status switch {
                                    MovieBookingApp.Models.BookingStatus.Confirmed => "bg-success",
                                    MovieBookingApp.Models.BookingStatus.Cancelled => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @cls">@b.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-info btn-action"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
