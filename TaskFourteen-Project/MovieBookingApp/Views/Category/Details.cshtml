@model MovieBookingApp.Models.Category

<div class="container mt-4">
    <h2>@Model.Name</h2>
    <h4 class="mt-3">Movies in this Category</h4>
    <ul class="list-group">
        @foreach (var m in Model.Movies ?? new List<MovieBookingApp.Models.Movie>())
        {
            <li class="list-group-item">@m.Name</li>
        }
    </ul>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
</div>
