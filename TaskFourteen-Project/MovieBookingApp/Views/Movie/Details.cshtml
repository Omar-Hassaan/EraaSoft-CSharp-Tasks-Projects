@model MovieBookingApp.Models.Movie

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.MainImg" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-8">
            <h2>@Model.Name</h2>
            <p>@Model.Des</p>
            <p><b>Price:</b> @Model.Price EGP</p>
            <p><b>Category:</b> @Model.Category?.Name</p>
            <p><b>Cinema:</b> @Model.Cinema?.Name</p>
            <p><b>Date:</b> @Model.DateTime.ToString("yyyy-MM-dd HH:mm")</p>
            <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">
                @(Model.Status ? "Available" : "Not Available")
            </span>
            <hr />
            <h5>Actors</h5>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var a in Model.Actors ?? new List<MovieBookingApp.Models.Actor>())
                {
                    <div class="text-center">
                        <img src="@a.Img" width="70" height="70" class="rounded-circle shadow" />
                        <p class="mt-1">@a.Name</p>
                    </div>
                }
            </div>
            <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
        </div>
    </div>
</div>
