@model MovieBookingApp.Models.Actor
@{ ViewData["Title"] = "Actor Details"; }

<div class="card" style="max-width:600px;margin:auto">
    <div class="card-body text-center p-4">
        <img src="@(Model.ImageUrl ?? "https://via.placeholder.com/100")"
             width="100" height="100" class="rounded-circle shadow mb-3" style="object-fit:cover" />
        <h4 class="fw-bold">@Model.Name</h4>
        <p class="text-muted">@Model.Bio</p>
        <hr />
        <h6 class="fw-bold">Movies</h6>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            @foreach (var ma in Model.MovieActors ?? new List<MovieBookingApp.Models.MovieActor>())
            {
                <span class="badge bg-light text-dark border px-3 py-2">🎬 @ma.Movie?.Name</span>
            }
        </div>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>
