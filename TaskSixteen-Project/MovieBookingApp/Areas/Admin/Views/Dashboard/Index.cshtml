@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;background:rgba(233,69,96,0.15)">
                    <i class="bi bi-camera-video-fill text-danger fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Movies</div>
                    <div class="fs-3 fw-bold">@ViewBag.TotalMovies</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;background:rgba(13,202,240,0.15)">
                    <i class="bi bi-ticket-perforated-fill text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Bookings</div>
                    <div class="fs-3 fw-bold">@ViewBag.TotalBookings</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;background:rgba(25,135,84,0.15)">
                    <i class="bi bi-person-badge-fill text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Actors</div>
                    <div class="fs-3 fw-bold">@ViewBag.TotalActors</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;background:rgba(255,193,7,0.15)">
                    <i class="bi bi-building-fill text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Cinemas</div>
                    <div class="fs-3 fw-bold">@ViewBag.TotalCinemas</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-danger"></i>Recent Bookings</h6>
            </div>
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr class="text-muted">
                            <th>#</th>
                            <th>Customer</th>
                            <th>Movie</th>
                            <th>Seats</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentBookings is List<MovieBookingApp.Models.Booking> bookings)
                        {
                            @foreach (var b in bookings)
                            {
                                <tr>
                                    <td class="text-muted">#@b.Id</td>
                                    <td>
                                        <div class="fw-semibold">@b.CustomerName</div>
                                        <div class="text-muted small">@b.CustomerEmail</div>
                                    </td>
                                    <td>@b.Movie?.Name</td>
                                    <td>@b.NumberOfSeats</td>
                                    <td class="fw-semibold">@b.TotalPrice.ToString("C")</td>
                                    <td>
                                        @{
                                            var badgeClass = b.Status switch {
                                                MovieBookingApp.Models.BookingStatus.Confirmed => "bg-success",
                                                MovieBookingApp.Models.BookingStatus.Cancelled => "bg-danger",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <span class="badge badge-status @badgeClass">@b.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="btn btn-sm btn-outline-danger">View All Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h6 class="fw-bold mb-0"><i class="bi bi-grid-fill me-2 text-primary"></i>Quick Actions</h6>
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-area="Admin" asp-controller="Movie" asp-action="Create" class="btn btn-outline-danger">
                    <i class="bi bi-plus-circle me-2"></i>Add New Movie
                </a>
                <a asp-area="Admin" asp-controller="Actor" asp-action="Create" class="btn btn-outline-success">
                    <i class="bi bi-plus-circle me-2"></i>Add New Actor
                </a>
                <a asp-area="Admin" asp-controller="Cinema" asp-action="Create" class="btn btn-outline-warning">
                    <i class="bi bi-plus-circle me-2"></i>Add New Cinema
                </a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-outline-info">
                    <i class="bi bi-plus-circle me-2"></i>Add New Category
                </a>
            </div>
        </div>
    </div>
</div>
