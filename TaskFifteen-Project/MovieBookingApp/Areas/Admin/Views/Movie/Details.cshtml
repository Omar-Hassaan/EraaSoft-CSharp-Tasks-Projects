@model MovieBookingApp.Models.Movie
@{ ViewData["Title"] = "Movie Details"; }

<div class="card">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-4">
                <img src="@(Model.MainImageUrl ?? "https://via.placeholder.com/400x250?text=No+Image")"
                     class="img-fluid rounded-3 shadow w-100" style="object-fit:cover;max-height:280px" />
            </div>
            <div class="col-md-8">
                <h3 class="fw-bold">@Model.Name</h3>
                <p class="text-muted">@Model.Description</p>
                <div class="row g-2 mb-3">
                    <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2">📁 @Model.Category?.Name</span></div>
                    <div class="col-auto"><span class="badge bg-light text-dark border px-3 py-2">🏛 @Model.Cinema?.Name</span></div>
                    <div class="col-auto"><span class="badge @(Model.IsAvailable ? "bg-success" : "bg-secondary") px-3 py-2">@(Model.IsAvailable ? "✅ Available" : "❌ Unavailable")</span></div>
                </div>
                <p><strong>Price:</strong> @Model.Price.ToString("N0") EGP per ticket</p>
                <p><strong>Show Date:</strong> @Model.ShowDateTime.ToString("dddd, MMMM dd, yyyy HH:mm")</p>
                <hr />
                <h6 class="fw-bold mb-3">Cast</h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var ma in Model.MovieActors ?? new List<MovieBookingApp.Models.MovieActor>())
                    {
                        <div class="text-center">
                            <img src="@(ma.Actor?.ImageUrl ?? "https://via.placeholder.com/60")"
                                 width="55" height="55" class="rounded-circle shadow" style="object-fit:cover" />
                            <div class="small mt-1">@ma.Actor?.Name</div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
