@model MovieBookingApp.Models.Actor
@{ ViewData["Title"] = "Edit Actor"; }

<div class="card" style="max-width:500px;margin:auto">
    <div class="card-header bg-white border-0 pt-4 px-4">
        <h6 class="fw-bold mb-0"><i class="bi bi-pencil me-2 text-warning"></i>Edit Actor</h6>
    </div>
    <div class="card-body px-4 pb-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Actor Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label fw-semibold">Photo URL</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Bio" class="form-label fw-semibold">Bio</label>
                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4"><i class="bi bi-save me-1"></i>Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
