@model IEnumerable<MovieBookingApp.Models.Booking>
@{ ViewData["Title"] = "My Bookings"; string email = ViewBag.Email; }

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-white mb-0">My Bookings</h4>
            <p class="text-muted small">Bookings for: <strong class="text-white">@email</strong></p>
        </div>
        <a asp-action="MyBookings" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-search me-1"></i>Search Different Email
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-ticket-perforated fs-1 mb-3 d-block opacity-25"></i>
            <p>No bookings found for this email.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var b in Model)
            {
                <div class="col-md-6">
                    <div class="card-dark p-4 rounded-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold text-white mb-0">@b.Movie?.Name</h6>
                                <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>@b.Movie?.Cinema?.Name</p>
                            </div>
                            @{
                                var cls = b.Status switch {
                                    MovieBookingApp.Models.BookingStatus.Confirmed => "bg-success",
                                    MovieBookingApp.Models.BookingStatus.Cancelled => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @cls">@b.Status</span>
                        </div>
                        <hr style="border-color:rgba(255,255,255,0.08)" />
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div class="text-muted small">Seats</div>
                                <div class="fw-bold text-white">@b.NumberOfSeats</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small">Total</div>
                                <div class="fw-bold text-primary-red">@b.TotalPrice.ToString("N0") EGP</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small">Date</div>
                                <div class="fw-bold text-white small">@b.BookingDate.ToString("dd MMM")</div>
                            </div>
                        </div>
                        @if (b.Status == MovieBookingApp.Models.BookingStatus.Confirmed)
                        {
                            <form asp-action="Cancel" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="email" value="@email" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                        onclick="return confirm('Cancel this booking?')">
                                    <i class="bi bi-x-circle me-1"></i>Cancel Booking
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
