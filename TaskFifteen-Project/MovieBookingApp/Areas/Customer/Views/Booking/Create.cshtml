@model MovieBookingApp.Models.Booking
@{ ViewData["Title"] = "Book Tickets"; var movie = ViewBag.Movie as MovieBookingApp.Models.Movie; }

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            @if (movie != null)
            {
                <div class="card-dark rounded-3 overflow-hidden">
                    <img src="@(movie.MainImageUrl ?? "https://via.placeholder.com/400x220")"
                         class="w-100" style="height:200px;object-fit:cover" />
                    <div class="p-3">
                        <h6 class="fw-bold text-white">@movie.Name</h6>
                        <p class="text-muted small mb-1"><i class="bi bi-building me-1"></i>@movie.Cinema?.Name</p>
                        <p class="text-muted small mb-1"><i class="bi bi-calendar me-1"></i>@movie.ShowDateTime.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="text-primary-red fw-bold mb-0">@movie.Price.ToString("N0") EGP per seat</p>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-6">
            <div class="card-dark p-4 rounded-3">
                <h4 class="fw-bold text-white mb-4"><i class="bi bi-ticket-perforated me-2 text-primary-red"></i>Book Your Seats</h4>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="MovieId" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label text-muted small">FULL NAME</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Your full name" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CustomerEmail" class="form-label text-muted small">EMAIL</label>
                        <input asp-for="CustomerEmail" class="form-control" type="email" placeholder="your@email.com" />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CustomerPhone" class="form-label text-muted small">PHONE</label>
                        <input asp-for="CustomerPhone" class="form-control" placeholder="+20 1xx xxx xxxx" />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="NumberOfSeats" class="form-label text-muted small">NUMBER OF SEATS</label>
                        <input asp-for="NumberOfSeats" class="form-control" type="number" min="1" max="10" value="1" />
                        @if (movie != null)
                        {
                            <div class="text-muted small mt-1">Total: <span id="totalPrice" class="text-primary-red fw-bold">@movie.Price.ToString("N0") EGP</span></div>
                        }
                    </div>
                    <button type="submit" class="btn btn-book w-100 py-3 fs-6">
                        <i class="bi bi-check-circle me-2"></i>Confirm Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const price = @(movie?.Price ?? 0);
        document.querySelector('[name="NumberOfSeats"]').addEventListener('input', function() {
            document.getElementById('totalPrice').textContent = (this.value * price).toLocaleString() + ' EGP';
        });
    </script>
}
